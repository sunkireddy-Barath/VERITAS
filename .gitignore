# Model artifacts — large binaries, reproducible from the notebooks
checkpoints/*.pt
checkpoints/*.bin
checkpoints/tokenizer.json
!checkpoints/.gitkeep

# Data — fetched from real sources, never committed
data/raw/*
data/processed/*
data/real/*
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Notebook outputs are stripped before commit (see scripts/strip_notebooks.py)

# Local config / secrets
.env
.env.local
*.pem

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Deploy staging and generated secrets (scripts/deploy_hf_space.py)
.deploy/
