# Copy to .env and fill in. NEVER commit .env.

# --- Runtime ----------------------------------------------------------------
VERITAS_DEVICE=cpu                    # cpu | cuda (unset = auto-detect)
# Comma-separated origins allowed to call the API from a browser. Add your
# Vercel domain (https://<project>.vercel.app) before going public.
VERITAS_ALLOWED_ORIGIN=http://localhost:8000,http://localhost:3000

# Unset => write endpoints are open (local dev only). Set it and /ingest and
# /refresh require the X-API-Key header.
VERITAS_API_KEY=
VERITAS_RATE_LIMIT_PER_MIN=60
# Set to 1 ONLY behind a proxy that overwrites X-Forwarded-For (Fly, nginx).
# Otherwise clients can forge the header and dodge the rate limit.
VERITAS_TRUST_PROXY=
VERITAS_LOG_LEVEL=INFO
# Optional: where the real data lives. Default data/real, then the image's seed.
VERITAS_DATA_DIR=

# --- Streaming (optional; unset = no bus, /ingest and /refresh are synchronous)
# With a broker set, the API consumes veritas.raw in a background thread and
# /ingest also writes each document to the log so the store can be replayed.
VERITAS_KAFKA_BOOTSTRAP=              # kafka:9092 in compose, host:9092 elsewhere
VERITAS_KAFKA_GROUP=                  # default veritas-api-<hostname>, one per replica
# Managed clusters (Confluent Cloud, Redpanda Cloud, Aiven) need SASL over TLS:
VERITAS_KAFKA_SECURITY_PROTOCOL=      # SASL_SSL | SSL | PLAINTEXT (default)
VERITAS_KAFKA_SASL_MECHANISM=         # PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
VERITAS_KAFKA_USERNAME=
VERITAS_KAFKA_PASSWORD=

# --- Frontend on Vercel -----------------------------------------------------
# Set in the Vercel project, not here: build-config.mjs writes it to config.js.
# VERITAS_API_URL=https://<your-app>.fly.dev

# --- Politeness -------------------------------------------------------------
# SEC EDGAR REQUIRES a User-Agent identifying you, with contact details.
# Requests without one are throttled or blocked.
VERITAS_USER_AGENT=VERITAS-research/0.1 (you@example.com)
