# Copy to .env and fill in. NEVER commit .env.

# --- Database (optional; in-memory store is used when unset) ---------------
VERITAS_DATABASE_URL=postgresql://veritas:CHANGE_ME@localhost:5432/veritas
POSTGRES_PASSWORD=CHANGE_ME

# --- Cache (optional) -------------------------------------------------------
VERITAS_REDIS_URL=redis://localhost:6379/0

# --- Streaming bus (optional; in-process queue when unset) ------------------
# Setting this switches the ingestion pipeline onto Kafka.
VERITAS_KAFKA_BOOTSTRAP=

# --- Runtime ----------------------------------------------------------------
VERITAS_DEVICE=cpu                    # cpu | cuda
VERITAS_ALLOWED_ORIGIN=http://localhost:8000
VERITAS_LOG_LEVEL=INFO

# --- Politeness -------------------------------------------------------------
# SEC EDGAR REQUIRES a User-Agent identifying you, with contact details.
# Requests without one are throttled or blocked.
VERITAS_USER_AGENT=VERITAS-research/0.1 (you@example.com)
